# Copy to .env and fill in. Nothing here is a real secret.
# LLM is OPTIONAL: leave LLM_API_KEY empty and the pipeline runs in rule-based mode.
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:20b-cloud

# Mock CRM service (started by `make crm` / scripts/run_demo.sh)
CRM_BASE_URL=http://127.0.0.1:8077
CRM_TIMEOUT_S=2.0
CRM_RETRIES=2

# Failure injection for the mock CRM: 0.0 = perfect, 0.3 = ~30% of calls misbehave.
CRM_CHAOS=0.0
CRM_CHAOS_SEED=7
